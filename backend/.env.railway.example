# These are auto-provided by Railway when you add a PostgreSQL plugin:
# DATABASE_URL=postgresql://...  (Railway sets this automatically)

# Override individual vars if needed:
NODE_ENV=production
PORT=3001

# Railway PostgreSQL plugin sets these automatically — or use DATABASE_URL
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_NAME=${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Set this to your Vercel frontend URL
CORS_ORIGIN=https://smart-road-gis-dashboard.vercel.app
