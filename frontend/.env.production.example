# Set these in Vercel → Project → Settings → Environment Variables

# Your Railway backend URL (set after deploying backend)
REACT_APP_API_URL=https://smart-road-backend.up.railway.app

# WebSocket URL (same host, ws:// or wss://)
REACT_APP_WS_URL=wss://smart-road-backend.up.railway.app/ws

# Dashboard access password — change this!
REACT_APP_PREVIEW_PASSWORD=your-secret-password-here
